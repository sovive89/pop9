# Endereço e chave pública (anon) do projeto Supabase — os mesmos do app.
SUPABASE_URL=https://SEU_PROJETO.supabase.co
SUPABASE_ANON_KEY=SUA_CHAVE_ANON_PUBLICA

# Conta própria do agente (crie um usuário só para ele, com o papel "Cozinha" na unidade).
# Nunca use a chave service_role aqui.
POP9_AGENT_EMAIL=impressora@sualoja.com.br
POP9_AGENT_PASSWORD=SENHA_FORTE

# Unidade atendida por este computador.
POP9_UNIT_ID=UUID_DA_UNIDADE

# Opcionais
POLL_INTERVAL_MS=10000
CATCH_UP_HOURS=2
